# Copy to .env (git-ignored) and fill in. The backend reads it on startup;
# real environment variables override these values.

# Any OpenAI-compatible endpoint. Example: Alibaba Cloud Bailian (DashScope).
# International accounts use https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FAST_MODEL=qwen3.8-flash
LLM_REASONING_MODEL=qwen3.8-flash
